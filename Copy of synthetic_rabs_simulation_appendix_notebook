urce_location\": source,\n","            \"baseline_lambda\": baseline,\n","            \"event_start\": event_start,\n","            \"airflow_decay\": airflow_decay,\n","            \"source_strength\": source_strength,\n","        }\n","    )\n","\n","df = pd.DataFrame(records)\n","summary_df = pd.DataFrame(summary_rows)\n","\n","df.to_csv(OUTDIR / \"synthetic_rabs_particle_dataset.csv\", index=False)\n","summary_df.to_csv(OUTDIR / \"synthetic_rabs_event_summary.csv\", index=False)\n","\n","print(df.shape)\n","print(summary_df.shape)\n","df.head()\n","\"\"\"\n","))\n","\n","notebook_cells.append(md_cell(\n","\"\"\"## Data dictionary\n","\n","### Time-series file\n","- `event_id`: unique contamination event identifier\n","- `event_type`: contamination mechanism class\n","- `source_location`: simulated source cell\n","- `sensor_id`: sensor identifier\n","- `sensor_position`: numeric sensor position\n","- `time_step`: sequential observation index\n","- `baseline_lambda`: baseline Poisson rate\n","- `event_start`: time index when contamination begins\n","- `airflow_decay`: controls spatial attenuation\n","- `source_strength`: contamination intensity modifier\n","- `distance_from_source`: sensor-to-source distance\n","- `spatial_weight`: exponential decay factor\n","- `particle_count`: observed particle count\n","- `freeman_tukey`: variance-stabilized count transform\n","\n","### Event summary file\n","One row per simulated event to support grouping, stratification, or train/test splitting.\n","\"\"\"\n","))\n","\n","notebook_cells.append(code_cell(\n","\"\"\"# Example: create one event-level wide matrix for downstream time series classification\n","event_sensor_time = (\n","    df.pivot_table(\n","        index=[\"event_id\", \"event_type\", \"source_location\"],\n","        columns=[\"sensor_id\", \"time_step\"],\n","        values=\"freeman_tukey\"\n","    )\n","    .sort_index(axis=1)\n",")\n","\n","print(event_sensor_time.shape)\n","event_sensor_time.head()\n","\"\"\"\n","))\n","\n","notebook_cells.append(md_cell(\n","\"\"\"## Optional: threshold-based baseline for comparison\n","\n","This simple baseline flags an event when any sensor count exceeds a fixed threshold.\n","You can compare this rule against a learned classifier in the manuscript.\n","\"\"\"\n","))\n","\n","notebook_cells.append(code_cell(\n","\"\"\"THRESHOLD = 20\n","\n","threshold_detection = (\n","    df.assign(exceeded=lambda x: x[\"particle_count\"] >= THRESHOLD)\n","      .groupby(\"event_id\")[\"exceeded\"]\n","      .any()\n","      .rename(\"threshold_flag\")\n","      .reset_index()\n",")\n","\n","threshold_detection.head()\n","\"\"\"\n","))\n","\n","notebook_cells.append(md_cell(\n","\"\"\"## Suggested manuscript language\n","\n","A synthetic dataset was generated to emulate airborne particle behavior within an aseptic Restricted Access Barrier System.\n","Particle counts were simulated as Poisson-distributed arrivals across six spatially distributed sensors over 60 time steps per event.\n","Three contamination mechanisms were encoded: glove breach, mechanical friction, and HVAC drift.\n","Spatial propagation was modeled through exponential distance decay, and count data were variance-stabilized using the Freeman–Tukey transform before time series analysis.\n","\n","This dataset is suitable for:\n","- supervised time series classification\n","- Bayesian source localization\n","- threshold-versus-model detection comparisons\n","\"\"\"\n","))\n","\n","notebook = {\n","    \"cells\": notebook_cells,\n","    \"metadata\": {\n","        \"kernelspec\": {\n","            \"display_name\": \"Python 3\",\n","            \"language\": \"python\",\n","            \"name\": \"python3\",\n","        },\n","        \"language_info\": {\n","            \"name\": \"python\",\n","            \"version\": \"3.11\",\n","        },\n","    },\n","    \"nbformat\": 4,\n","    \"nbformat_minor\": 5,\n","}\n","\n","ipynb_path = outdir / \"synthetic_rabs_simulation_append