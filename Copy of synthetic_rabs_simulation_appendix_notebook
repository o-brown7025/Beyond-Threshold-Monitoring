ique_values\": 180,\n        \"samples\": [\n          2.201134406071299,\n          2.5459836714402053,\n          2.126309168404024\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"event_start\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 2,\n        \"min\": 8,\n        \"max\": 15,\n        \"num_unique_values\": 8,\n        \"samples\": [\n          13,\n          10,\n          14\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"airflow_decay\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.17242961377662952,\n        \"min\": 0.7009111800377164,\n        \"max\": 1.2972770019714943,\n        \"num_unique_values\": 180,\n        \"samples\": [\n          0.7665529847312852,\n          1.0578811344151995,\n          1.2972770019714943\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"source_strength\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.0835651494170798,\n        \"min\": 0.9051664560184899,\n        \"max\": 1.1992887402004864,\n        \"num_unique_values\": 180,\n        \"samples\": [\n          0.9478519935121047,\n          1.005957875968429,\n          1.0375472312989857\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"distance_from_source\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1,\n        \"min\": 0,\n        \"max\": 4,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          0,\n          4,\n          2\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"spatial_weight\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.3285755749560739,\n        \"min\": 0.0033231000573536954,\n        \"max\": 1.0,\n        \"num_unique_values\": 638,\n        \"samples\": [\n          0.03153027301941296,\n          0.2097733173227118,\n          0.03256740010618594\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"particle_count\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 3,\n        \"min\": 0,\n        \"max\": 31,\n        \"num_unique_values\": 31,\n        \"samples\": [\n          31,\n          10,\n          18\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"freeman_tukey\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1.5635376122228641,\n        \"min\": 1.0,\n        \"max\": 11.224618612322402,\n        \"num_unique_values\": 31,\n        \"samples\": [\n          11.224618612322402,\n          6.47890245052378,\n          8.601539630659959\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":1}],"source":["import json\n","import os\n","from pathlib import Path\n","import numpy as np\n","import pandas as pd\n","\n","outdir = Path(\"/mnt/data\")\n","outdir.mkdir(parents=True, exist_ok=True)\n","\n","rng = np.random.default_rng(42)\n","\n","# ----------------------------\n","# Synthetic dataset generation\n","# ----------------------------\n","n_events = 180\n","n_sensors = 6\n","n_timesteps = 60\n","sensor_positions = np.arange(n_sensors)\n","\n","event_types = [\"GloveBreach\", \"MechanicalFriction\", \"HVACDrift\"]\n","source_locations = [1, 2, 3, 4]\n","\n","records = []\n","summary_rows = []\n","\n","def glove_breach_pattern(t):\n","    return 18 * np.exp(-0.10 * t)\n","\n","def mechanical_pattern(t):\n","    return 6 + 4*np.sin(2*np.pi*t/8) + 2*np.sin(2*np.pi*t/4)\n","\n","def hvac_drift_pattern(t):\n","    return 0.20 * t\n","\n","for event_id in range(1, n_events + 1):\n","    event_type = event_types[(event_id - 1) % len(event_types)]\n","    source = int(rng.choice(source_locations))\n","    baseline = float(rng.uniform(1.0, 3.0))\n","    event_start = int(rng.integers(8, 16))\n","    airflow_decay = float(rng.uniform(0.7, 1.3))\n","    source_strength = float(rng.uniform(0.9, 1.2))\n","\n","    for sensor in sensor_positions:\n","        distance = abs(sensor - source)\n","        spatial_weight = np.exp(-(distance / airflow_decay))\n","\n","        for t in range(n_timesteps):\n","            lam = baseline\n","\n","            if t >= event_start:\n","                local_t = t - event_start\n","                if event_type == \"GloveBreach\":\n","                    lam += source_strength * spatial_weight * glove_breach_pattern(local_t)\n","                elif event_type == \"MechanicalFriction\":\n","                    lam += source_strength * spatial_weight * mechanical_pattern(local_t)\n","                elif event_type == \"HVACDrift\":\n","                    # HVAC drift affects all sensors more broadly, but still slightly stronger near source\n","                    lam += source_strength * (0.6 + 0.4 * spatial_weight) * hvac_drift_pattern(local_t)\n","\n","            lam = max(lam, 0.05)\n","            count = int(rng.poisson(lam))\n","            ft_transform = float(np.sqrt(count) + np.sqrt(count + 1))\n","\n","            records.append(\n","                {\n","                    \"event_id\": event_id,\n","                    \"event_type\": event_type,\n","                    \"source_location\": source,\n","                    \"sensor_id\": sensor,\n","                    \"sensor_position\": float(sensor),\n","                    \"time_step\": t,\n","                    \"baseline_lambda\": baseline,\n","                    \"event_start\": event_start,\n","                    \"airflow_decay\": airflow_decay,\n","                    \"source_strength\": source_strength,\n","                    \"distance_from_source\": distance,\n","                    \"spatial_weight\": spatial_weight,\n","                    \"particle_count\": count,\n","                    \"freeman_tukey\": ft_transform,\n","                }\n","            )\n","\n","    summary_rows.append(\n","        {\n","            \"event_id\": event_id,\n","            \"event_type\": event_type,\n","            \"source_location\": source,\n","            \"baseline_lambda\": baseline,\n","            \"event_start\": event_start,\n","            \"airflow_decay\": airflow_decay,\n","            \"source_strength\": source_strength,\n","        }\n","    )\n","\n","df = pd.DataFrame(records)\n","summary_df = pd.DataFrame(summary_rows)\n","\n","csv_path = outdir / \"synthetic_rabs_particle_dataset.csv\"\n","summary_path = outdir / \"synthetic_rabs_event_summary.csv\"\n","df.to_csv(csv_path, index=False)\n","summary_df.to_csv(summary_path, index=False)\n","\n","# ----------------------------\n","# Build a Jupyter notebook\n","# ----------------------------\n","notebook_cells = []\n","\n","def md_cell(text):\n","    return {\n","        \"cell_type\": \"markdown\",\n","        \"metadata\": {},\n","        \"source\": text.splitlines(keepends=True),\n","    }\n","\n","def code_cell(code):\n","    return {\n","        \"cell_type\": \"code\",\n","        \"execution_count\": None,\n","        \"metadata\": {},\n","        \"outputs\": [],\n","        \"source\": code.splitlines(keepends=True),\n","    }\n","\n","notebook_cells.append(md_cell(\n","\"\"\"# Appendix A. Synthetic Dataset and Reproducible Simulation Workflow\n","\n","This notebook generates a synthetic environmental monitoring dataset for an aseptic Restricted Access Barrier System (RABS).\n","The simulation is designed to support the article *Beyond Threshold Monitoring: A Bayesian and Time Series Framework for Predictive Contamination Control in Aseptic Manufacturing*.\n","\n","## Objectives\n","1. Simulate particle-count time series from multiple sensors.\n","2. Encode three contamination mechanisms:\n","   - **Glove breach**\n","   - **Mechanical friction**\n","   - **HVAC drift**\n","3. Preserve metadata needed for:\n","   - time series classification\n","   - Bayesian source localization\n","   - comparison against threshold-based monitoring\n","\n","## Output files\n","- `synthetic_rabs_particle_dataset.csv`\n","- `synthetic_rabs_event_summary.csv`\n","\"\"\"\n","))\n","\n","notebook_cells.append(code_cell(\n","\"\"\"import numpy as np\n","import pandas as pd\n","from pathlib import Path\n","\n","OUTDIR = Path(\".\")\n","RNG = np.random.default_rng(42)\n","\n","n_events = 180\n","n_sensors = 6\n","n_timesteps = 60\n","sensor_positions = np.arange(n_sensors)\n","\n","event_types = [\"GloveBreach\", \"MechanicalFriction\", \"HVACDrift\"]\n","source_locations = [1, 2, 3, 4]\n","\n","def glove_breach_pattern(t):\n","    return 18 * np.exp(-0.10 * t)\n","\n","def mechanical_pattern(t):\n","    return 6 + 4*np.sin(2*np.pi*t/8) + 2*np.sin(2*np.pi*t/4)\n","\n","def hvac_drift_pattern(t):\n","    return 0.20 * t\n","\"\"\"\n","))\n","\n","notebook_cells.append(md_cell(\n","\"\"\"## Generate the synthetic RABS particle dataset\n","\n","The simulation assumes:\n","- low baseline particle counts consistent with controlled environments\n","- Poisson-distributed particle arrivals\n","- spatial attenuation as a function of distance from the source\n","- event-specific temporal signatures\n","\"\"\"\n","))\n","\n","notebook_cells.append(code_cell(\n","\"\"\"records = []\n","summary_rows = []\n","\n","for event_id in range(1, n_events + 1):\n","    event_type = event_types[(event_id - 1) % len(event_types)]\n","    source = int(RNG.choice(source_locations))\n","    baseline = float(RNG.uniform(1.0, 3.0))\n","    event_start = int(RNG.integers(8, 16))\n","    airflow_decay = float(RNG.uniform(0.7, 1.3))\n","    source_